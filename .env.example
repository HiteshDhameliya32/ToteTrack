RECONNECT_DELAY=5000
TCP_MATCHING_WINDOW=30
ZONE_CYCLE_TIME_MS=2000
INITIAL_MESSAGE=Hello TCP Server
LOG_FOLDER=logs

# Express / API server
API_PORT=8001
EMAIL_PORT=4001

# Database (SQLite — file stored at project root)
DB_PATH=./tcp_logs.db

# Migration endpoint — change this before exposing publicly
MIGRATE_API_KEY=tcp_migrate_secret

# Auto Cleanup
ENABLE_AUTO_CLEANUP=true
DATA_RETENTION_DAYS=7
CLEANUP_TIME=02:00